# ─────────────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env.local` (que é ignorado pelo git) e preencha.
# NUNCA cole chaves no chat, em prompts, em código ou em arquivos versionados.
# `.env.local` fica só na sua máquina / nas variáveis de ambiente do deploy.
# ─────────────────────────────────────────────────────────────────────────

# IA (LLM) — SOMENTE no servidor. Não use prefixo NEXT_PUBLIC (isso vazaria no client).
OPENAI_API_KEY=
# Endpoint/modelo opcionais (default OpenAI). Compatível com Groq/OpenRouter etc.
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
# Cota diária de IA por usuário logado (defesa em profundidade). Default 50.
AI_DAILY_LIMIT=50

# URL pública do site — p/ canonical e og:url corretos (ex.: https://seu-app.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Supabase
# URL e ANON KEY podem ir pro client (são públicas; protegidas por RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE ROLE é SEGREDO — só no servidor, jamais com NEXT_PUBLIC:
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform
# Chave do Maps JS (client): restrinja por referrer HTTP no console do Google.
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=
# Chave do Places/Geocoding (server): mantenha secreta e restrinja por API + IP.
GOOGLE_PLACES_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Assinatura (Stripe) — SOMENTE no servidor. Sem isto, o app funciona 100%
# no plano grátis (no-op seguro). Veja docs/STRIPE-SETUP.md.
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de price recorrentes criados no painel do Stripe:
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=

# ─────────────────────────────────────────────────────────────────────────
# Afiliados — IDs públicos (podem ir pro client com NEXT_PUBLIC). Sem eles, os
# deep-links abrem normalmente, só sem a tag (no-op seguro). Cadastre-se nas
# redes/programas (ver docs/plataforma/06-modelo-de-monetizacao.md):
#  • Travelpayouts (1 cadastro destrava Kiwi/Trip.com/GYG/Klook/Omio/Civitatis)
#  • Viator e Civitatis (programas próprios, aprovam rápido) · Wise (PartnerWise)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AFF_BOOKING=
NEXT_PUBLIC_AFF_VIATOR=
NEXT_PUBLIC_AFF_GYG=
NEXT_PUBLIC_AFF_KLOOK=
NEXT_PUBLIC_AFF_CIVITATIS=
NEXT_PUBLIC_AFF_TRAVELPAYOUTS=
NEXT_PUBLIC_AFF_WISE=
NEXT_PUBLIC_AFF_SAFETYWING=

# Analytics (opcional) — qualquer valor "liga" a costura de event-tracking
# (window.dataLayer). Sem isto, track() é no-op (em dev, loga no console).
NEXT_PUBLIC_ANALYTICS=
